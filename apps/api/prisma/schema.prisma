generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum MarketCategory {
  POLITICS
  SPORTS
  CRYPTO
  ECONOMY
  SCIENCE_TECH
  POP_CULTURE
  OTHER
}

enum MarketStatus {
  OPEN
  RESOLVED
}

enum MarketType {
  BINARY
  MULTI
}

enum BetSide {
  YES
  NO
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum MarketProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String   @unique
  passwordHash  String
  role          Role     @default(USER)
  walletBalance Decimal  @default(0) @db.Decimal(18, 2)
  createdAt     DateTime @default(now())

  walletAddress       String? @unique
  encryptedPrivateKey String?

  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  bets            Bet[]
  tickets         Ticket[]
  favorites       Favorite[]
  comments        Comment[]
  marketProposals MarketProposal[]
}

model Market {
  id              String         @id @default(cuid())
  title           String
  description     String
  type            MarketType     @default(BINARY)
  yesDescription  String?
  noDescription   String?
  category        MarketCategory
  status          MarketStatus   @default(OPEN)
  resolvedOutcome BetSide?
  startDate       DateTime
  endDate         DateTime

  yesPool     Decimal @default(50) @db.Decimal(18, 2)
  noPool      Decimal @default(50) @db.Decimal(18, 2)
  totalVolume Decimal @default(0) @db.Decimal(18, 2)

  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  resolvedOptionId String?
  resolvedOption   MarketOption? @relation("ResolvedOption", fields: [resolvedOptionId], references: [id])

  bets        Bet[]
  pricePoints PricePoint[]
  options     MarketOption[]
  tickets     Ticket[]
  favorites   Favorite[]
  comments    Comment[]
  proposal    MarketProposal?
}

model MarketOption {
  id        String @id @default(cuid())
  label     String
  sortOrder Int
  pool      Decimal @default(50) @db.Decimal(18, 2)

  marketId String
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  bets            Bet[]
  pricePoints     OptionPricePoint[]
  resolvedInMarkets Market[] @relation("ResolvedOption")

  @@index([marketId])
}

model Bet {
  id          String    @id @default(cuid())
  side        BetSide?
  amount      Decimal   @db.Decimal(18, 2)
  price       Decimal   @db.Decimal(5, 4)
  payout      Decimal?  @db.Decimal(18, 2)
  txHash      String?
  createdAt   DateTime  @default(now())
  chainIndex  Int       @default(0)
  withdrawnAt DateTime?

  // If a third Discord-announced event ever comes up, generalize this into a
  // separate (betId, event, notifiedAt) table instead of adding a third column.
  discordNotifiedAt         DateTime? // "bet placed" announced in the Discord bets feed
  discordWithdrawNotifiedAt DateTime? // "bet withdrawn" announced in the Discord bets feed

  userId String
  user   User   @relation(fields: [userId], references: [id])

  marketId String
  market   Market @relation(fields: [marketId], references: [id])

  optionId String?
  option   MarketOption? @relation(fields: [optionId], references: [id])

  tickets Ticket[]

  @@index([userId])
  @@index([marketId])
  @@index([optionId])
  @@index([discordNotifiedAt])
  @@index([discordWithdrawNotifiedAt])
}

model PricePoint {
  id        String   @id @default(cuid())
  yesPrice  Decimal  @db.Decimal(5, 4)
  timestamp DateTime @default(now())

  marketId String
  market   Market @relation(fields: [marketId], references: [id])

  @@index([marketId, timestamp])
}

model OptionPricePoint {
  id        String   @id @default(cuid())
  price     Decimal  @db.Decimal(5, 4)
  timestamp DateTime @default(now())

  optionId String
  option   MarketOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([optionId, timestamp])
}

model Ticket {
  id         String       @id @default(cuid())
  subject    String
  message    String
  status     TicketStatus @default(OPEN)
  adminNote  String?
  txHash     String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  betId String?
  bet   Bet?    @relation(fields: [betId], references: [id])

  marketId String?
  market   Market? @relation(fields: [marketId], references: [id])

  @@index([userId])
  @@index([status])
}

model MarketProposal {
  id             String     @id @default(cuid())
  title          String
  description    String
  type           MarketType @default(BINARY)
  yesDescription String?
  noDescription  String?
  optionLabels   String[]   @default([])
  category       MarketCategory
  startDate      DateTime
  endDate        DateTime

  status    MarketProposalStatus @default(PENDING)
  adminNote String?
  decidedBy String?
  createdAt DateTime             @default(now())
  decidedAt DateTime?

  proposerId String
  proposer   User   @relation(fields: [proposerId], references: [id])

  marketId String? @unique
  market   Market? @relation(fields: [marketId], references: [id])

  discordMessageId String?
  discordChannelId String?
  notifiedAt       DateTime?
  discordSyncedAt  DateTime?

  @@index([proposerId])
  @@index([status])
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  marketId String
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([userId, marketId])
  @@index([marketId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  marketId String
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId])
}
