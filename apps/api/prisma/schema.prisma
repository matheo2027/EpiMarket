generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum MarketCategory {
  POLITICS
  SPORTS
  CRYPTO
  ECONOMY
  SCIENCE_TECH
  POP_CULTURE
  OTHER
}

enum MarketStatus {
  OPEN
  RESOLVED
}

enum MarketType {
  BINARY
  MULTI
}

enum BetSide {
  YES
  NO
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String   @unique
  passwordHash  String
  role          Role     @default(USER)
  walletBalance Decimal  @default(0) @db.Decimal(18, 2)
  createdAt     DateTime @default(now())

  walletAddress       String? @unique
  encryptedPrivateKey String?

  bets    Bet[]
  tickets Ticket[]
}

model Market {
  id              String         @id @default(cuid())
  title           String
  description     String
  type            MarketType     @default(BINARY)
  yesDescription  String?
  noDescription   String?
  category        MarketCategory
  status          MarketStatus   @default(OPEN)
  resolvedOutcome BetSide?
  startDate       DateTime
  endDate         DateTime

  yesPool     Decimal @default(50) @db.Decimal(18, 2)
  noPool      Decimal @default(50) @db.Decimal(18, 2)
  totalVolume Decimal @default(0) @db.Decimal(18, 2)

  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  resolvedOptionId String?
  resolvedOption   MarketOption? @relation("ResolvedOption", fields: [resolvedOptionId], references: [id])

  bets        Bet[]
  pricePoints PricePoint[]
  options     MarketOption[]
  tickets     Ticket[]
}

model MarketOption {
  id        String @id @default(cuid())
  label     String
  sortOrder Int
  pool      Decimal @default(50) @db.Decimal(18, 2)

  marketId String
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  bets            Bet[]
  pricePoints     OptionPricePoint[]
  resolvedInMarkets Market[] @relation("ResolvedOption")

  @@index([marketId])
}

model Bet {
  id        String   @id @default(cuid())
  side      BetSide?
  amount    Decimal  @db.Decimal(18, 2)
  price     Decimal  @db.Decimal(5, 4)
  payout    Decimal? @db.Decimal(18, 2)
  txHash    String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  marketId String
  market   Market @relation(fields: [marketId], references: [id])

  optionId String?
  option   MarketOption? @relation(fields: [optionId], references: [id])

  tickets Ticket[]

  @@index([userId])
  @@index([marketId])
  @@index([optionId])
}

model PricePoint {
  id        String   @id @default(cuid())
  yesPrice  Decimal  @db.Decimal(5, 4)
  timestamp DateTime @default(now())

  marketId String
  market   Market @relation(fields: [marketId], references: [id])

  @@index([marketId, timestamp])
}

model OptionPricePoint {
  id        String   @id @default(cuid())
  price     Decimal  @db.Decimal(5, 4)
  timestamp DateTime @default(now())

  optionId String
  option   MarketOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([optionId, timestamp])
}

model Ticket {
  id         String       @id @default(cuid())
  subject    String
  message    String
  status     TicketStatus @default(OPEN)
  adminNote  String?
  txHash     String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  betId String?
  bet   Bet?    @relation(fields: [betId], references: [id])

  marketId String?
  market   Market? @relation(fields: [marketId], references: [id])

  @@index([userId])
  @@index([status])
}
